{
  "plansDirectory": ".claude/plans",
  "enabledPlugins": {
    "hookify@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/check_code_quality.sh --hooks",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
